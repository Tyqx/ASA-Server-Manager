<Window x:Class="ASAServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASA Server Manager"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#0F1115"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#0F1115">

        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TOP BAR -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="#151922"
                BorderBrush="#252B36"
                BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TITLE -->

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">

                    <TextBlock Text="ASA SERVER MANAGER"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  MULTI-SERVER"
                               Foreground="#7F8A9A"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="6,2,0,0"/>

                </StackPanel>

                <!-- ADD SERVER -->

                <Button x:Name="AddServerButton"
                        Grid.Column="1"
                        Content="+  Add Server"
                        Width="125"
                        Height="32"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Background="#202735"
                        Foreground="White"
                        BorderBrush="#343C4C"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="AddServerButton_Click"/>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- SERVER TABS -->
        <!-- ================================================= -->

        <TabControl x:Name="ServerTabControl"
                    Grid.Row="1"
                    Background="#0F1115"
                    BorderThickness="0"
                    Padding="0"
                    Margin="8,8,8,8"
                    SelectionChanged="ServerTabControl_SelectionChanged">

            <TabControl.Resources>

                <!-- TAB ITEM -->

                <Style TargetType="{x:Type TabItem}">

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="Background"
                            Value="#171B24"/>

                    <Setter Property="BorderBrush"
                            Value="#292F3B"/>

                    <Setter Property="BorderThickness"
                            Value="1"/>

                    <Setter Property="Padding"
                            Value="14,7"/>

                    <Setter Property="Margin"
                            Value="0,0,4,0"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>

                    <Setter Property="Template">

                        <Setter.Value>

                            <ControlTemplate TargetType="{x:Type TabItem}">

                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5,5,0,0"
                                        Padding="{TemplateBinding Padding}">

                                    <ContentPresenter
                                        ContentSource="Header"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsSelected"
                                             Value="True">

                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#222936"/>

                                        <Setter TargetName="TabBorder"
                                                Property="BorderBrush"
                                                Value="#3C4658"/>

                                    </Trigger>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter TargetName="TabBorder"
                                                Property="Background"
                                                Value="#1D2330"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Setter.Value>

                    </Setter>

                </Style>

            </TabControl.Resources>

        </TabControl>

    </Grid>

</Window>
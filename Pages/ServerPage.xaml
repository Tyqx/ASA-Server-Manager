<UserControl
    x:Class="ASAServerManager.Pages.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- PRIMARY BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Background" Value="#2D7DFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A91FF"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- SECONDARY BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Background" Value="#252932"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#343944"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- DARK TEXTBOX -->
        <!-- ===================================================== -->

        <Style x:Key="DarkTextBox"
               TargetType="TextBox">

            <Setter Property="Background" Value="#252932"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>


        <!-- ===================================================== -->
        <!-- DARK PASSWORD BOX -->
        <!-- ===================================================== -->

        <Style x:Key="DarkPasswordBox"
               TargetType="PasswordBox">

            <Setter Property="Background" Value="#252932"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>


        <!-- ===================================================== -->
        <!-- DARK COMBOBOX -->
        <!-- ===================================================== -->

        <Style x:Key="DarkComboBox"
               TargetType="ComboBox">

            <Setter Property="Background" Value="#252932"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <Border
                                Background="#252932"
                                BorderBrush="#3A3F4B"
                                BorderThickness="1"
                                CornerRadius="5">

                                <Grid>

                                    <ContentPresenter
                                        Margin="10,0,35,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                                    <Path
                                        Data="M 0 0 L 5 5 L 10 0"
                                        Stroke="#9AA1AF"
                                        StrokeThickness="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"/>

                                </Grid>

                            </Border>

                            <ToggleButton
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border Background="Transparent"/>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <Popup
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">

                                <Border
                                    Background="#252932"
                                    BorderBrush="#3A3F4B"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    MinWidth="{Binding ActualWidth,
                                        RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer
                                        MaxHeight="300"
                                        VerticalScrollBarVisibility="Auto">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX ITEMS -->
        <!-- ===================================================== -->

        <Style x:Key="DarkComboBoxItem"
               TargetType="ComboBoxItem">

            <Setter Property="Background" Value="#252932"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#2D7DFF"/>

                                <Setter
                                    Property="Foreground"
                                    Value="White"/>

                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#2D7DFF"/>

                                <Setter
                                    Property="Foreground"
                                    Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- CHECKBOX -->
        <!-- ===================================================== -->

        <Style TargetType="CheckBox">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN SCROLL VIEW -->
    <!-- ========================================================= -->

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="0"
                Margin="0,0,0,25">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="ASA Server"
                        Foreground="White"
                        FontSize="30"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="ARK: Survival Ascended Dedicated Server"
                        Foreground="#7F8796"
                        FontSize="14"
                        Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="SERVER STATUS"
                        Foreground="#7F8796"
                        FontSize="11"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>

                    <TextBlock
                        x:Name="ServerStatusText"
                        Text="● OFFLINE"
                        Foreground="IndianRed"
                        FontWeight="Bold"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- SERVER CONFIGURATION -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                Background="#191C22"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <TextBlock
                        Grid.Row="0"
                        Text="Server Configuration"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="0,0,0,20"/>


                    <!-- SERVER PATH / NAME -->

                    <Grid
                        Grid.Row="1"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,10,0">

                            <TextBlock
                                Text="Server Folder"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="ServerPathTextBox"
                                    Grid.Column="0"
                                    Style="{StaticResource DarkTextBox}"
                                    TextChanged="ServerPathTextBox_TextChanged"/>

                                <Button
                                    Grid.Column="1"
                                    Content="Browse"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseServerFolderButton_Click"/>

                            </Grid>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0">

                            <TextBlock
                                Text="Server Name"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <TextBox
                                x:Name="ServerNameTextBox"
                                Style="{StaticResource DarkTextBox}"/>

                        </StackPanel>

                    </Grid>


                    <!-- SHARED CONFIGURATION -->

                    <Border
                        Grid.Row="2"
                        Background="#14171C"
                        BorderBrush="#30343D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,0,12">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <CheckBox
                                x:Name="UseSharedConfigurationCheckBox"
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="Use Shared Configuration"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"
                                Checked="SharedConfigurationSettings_Changed"
                                Unchecked="SharedConfigurationSettings_Changed"/>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,10,0">

                                <TextBlock
                                    Text="Configuration Folder"
                                    Foreground="#7F8796"
                                    FontSize="12"
                                    Margin="0,0,0,5"/>

                                <TextBox
                                    x:Name="SharedConfigurationPathTextBox"
                                    Style="{StaticResource DarkTextBox}"
                                    IsEnabled="False"/>

                            </StackPanel>

                            <Button
                                x:Name="BrowseSharedConfigurationButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Content="Browse"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Bottom"
                                IsEnabled="False"
                                Click="BrowseSharedConfigurationButton_Click"/>

                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,12,0,0">

                                <TextBlock
                                    Text="What is Shared Configuration?"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,4"/>

                                <TextBlock
                                    Text="Use one configuration file across multiple servers. Servers using the same shared configuration will use the settings stored in the selected folder, making it easier to keep common server settings synchronized."
                                    Foreground="#7F8796"
                                    FontSize="11"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- MAP / PORTS -->

                    <Grid
                        Grid.Row="3"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,8,0">

                            <TextBlock
                                Text="Map"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <ComboBox
                                x:Name="MapComboBox"
                                Style="{StaticResource DarkComboBox}"
                                ItemContainerStyle="{StaticResource DarkComboBoxItem}">

                                <ComboBoxItem Content="TheIsland_WP"/>
                                <ComboBoxItem Content="ScorchedEarth_WP"/>
                                <ComboBoxItem Content="Aberration_WP"/>
                                <ComboBoxItem Content="TheCenter_WP"/>
                                <ComboBoxItem Content="Ragnarok_WP"/>
                                <ComboBoxItem Content="Extinction_WP"/>
                                <ComboBoxItem Content="Astraeos_WP"/>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Margin="8,0">

                            <TextBlock
                                Text="Server Port"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <TextBox
                                x:Name="ServerPortTextBox"
                                Style="{StaticResource DarkTextBox}"
                                Text="7777"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Margin="8,0">

                            <TextBlock
                                Text="Query Port"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <TextBox
                                x:Name="QueryPortTextBox"
                                Style="{StaticResource DarkTextBox}"
                                Text="27015"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            Margin="8,0,0,0">

                            <TextBlock
                                Text="Max Players"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <TextBox
                                x:Name="MaxPlayersTextBox"
                                Style="{StaticResource DarkTextBox}"
                                Text="70"/>

                        </StackPanel>

                    </Grid>


                    <!-- DIFFICULTY / PASSWORDS -->

                    <Grid
                        Grid.Row="4"
                        Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,8,0">

                            <TextBlock
                                Text="Difficulty"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <ComboBox
                                x:Name="DifficultyComboBox"
                                Style="{StaticResource DarkComboBox}"
                                ItemContainerStyle="{StaticResource DarkComboBoxItem}">

                                <ComboBoxItem Content="0.5"/>
                                <ComboBoxItem Content="1.0" IsSelected="True"/>
                                <ComboBoxItem Content="2.0"/>
                                <ComboBoxItem Content="3.0"/>
                                <ComboBoxItem Content="4.0"/>
                                <ComboBoxItem Content="5.0"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- SERVER PASSWORD -->

                        <StackPanel
                            Grid.Column="1"
                            Margin="8,0">

                            <TextBlock
                                Text="Server Password"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <PasswordBox
                                    x:Name="ServerPasswordBox"
                                    Grid.Column="0"
                                    Style="{StaticResource DarkPasswordBox}"
                                    Visibility="Visible"/>

                                <TextBox
                                    x:Name="ServerPasswordTextBox"
                                    Grid.Column="0"
                                    Style="{StaticResource DarkTextBox}"
                                    Visibility="Collapsed"/>

                                <CheckBox
                                    x:Name="ServerPasswordToggleCheckBox"
                                    Grid.Column="1"
                                    Content="Show"
                                    Foreground="White"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Checked="ServerPasswordToggleCheckBox_Checked"
                                    Unchecked="ServerPasswordToggleCheckBox_Unchecked"/>

                            </Grid>

                        </StackPanel>


                        <!-- ADMIN PASSWORD -->

                        <StackPanel
                            Grid.Column="2"
                            Margin="8,0">

                            <TextBlock
                                Text="Admin Password"
                                Foreground="#7F8796"
                                Margin="0,0,0,6"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <PasswordBox
                                    x:Name="AdminPasswordBox"
                                    Grid.Column="0"
                                    Style="{StaticResource DarkPasswordBox}"
                                    Visibility="Visible"/>

                                <TextBox
                                    x:Name="AdminPasswordTextBox"
                                    Grid.Column="0"
                                    Style="{StaticResource DarkTextBox}"
                                    Visibility="Collapsed"/>

                                <CheckBox
                                    x:Name="AdminPasswordToggleCheckBox"
                                    Grid.Column="1"
                                    Content="Show"
                                    Foreground="White"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Checked="AdminPasswordToggleCheckBox_Checked"
                                    Unchecked="AdminPasswordToggleCheckBox_Unchecked"/>

                            </Grid>

                        </StackPanel>


                        <!-- PVE / CROSSPLAY -->

                        <StackPanel
                            Grid.Column="3"
                            Margin="8,20,0,0">

                            <CheckBox
                                x:Name="PvECheckBox"
                                Content="PvE"/>

                            <CheckBox
                                x:Name="CrossplayCheckBox"
                                Content="Crossplay"
                                IsChecked="True"/>

                        </StackPanel>

                    </Grid>


                    <!-- WHITELIST -->

                    <Border
                        Grid.Row="5"
                        Background="#14171C"
                        BorderBrush="#30343D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <CheckBox
                                x:Name="WhitelistEnabledCheckBox"
                                Grid.Column="0"
                                Content="Enable Whitelist"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"
                                Checked="WhitelistSettings_Changed"
                                Unchecked="WhitelistSettings_Changed"/>

                            <StackPanel
                                Grid.Column="1"
                                Margin="0,0,15,0">

                                <TextBlock
                                    Text="Whitelist Mode"
                                    Foreground="#7F8796"
                                    FontSize="12"
                                    Margin="0,0,0,5"/>

                                <ComboBox
                                    x:Name="WhitelistModeComboBox"
                                    Style="{StaticResource DarkComboBox}"
                                    ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                    SelectedIndex="1">

                                    <ComboBoxItem Content="Player IDs"/>
                                    <ComboBoxItem Content="Steam IDs"/>

                                </ComboBox>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2">

                                <TextBlock
                                    Text="Whitelist Players"
                                    Foreground="#7F8796"
                                    FontSize="12"
                                    Margin="0,0,0,5"/>

                                <TextBox
                                    x:Name="WhitelistTextBox"
                                    Style="{StaticResource DarkTextBox}"
                                    MinHeight="45"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"
                                    TextChanged="WhitelistSettings_Changed"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- CLUSTER -->

                    <Border
                        Grid.Row="6"
                        Background="#14171C"
                        BorderBrush="#30343D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15"
                        Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <CheckBox
                                x:Name="ClusterEnabledCheckBox"
                                Grid.Column="0"
                                Content="Enable Cluster"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"/>

                            <StackPanel
                                Grid.Column="1"
                                Margin="0,0,15,0">

                                <TextBlock
                                    Text="Cluster ID"
                                    Foreground="#7F8796"
                                    FontSize="12"
                                    Margin="0,0,0,5"/>

                                <TextBox
                                    x:Name="ClusterIdTextBox"
                                    Style="{StaticResource DarkTextBox}"
                                    Text="ASACluster"/>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Margin="0,0,15,0">

                                <TextBlock
                                    Text="Cluster Directory"
                                    Foreground="#7F8796"
                                    FontSize="12"
                                    Margin="0,0,0,5"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="ClusterDirectoryTextBox"
                                        Grid.Column="0"
                                        Style="{StaticResource DarkTextBox}"/>

                                    <Button
                                        Grid.Column="1"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BrowseClusterDirectoryButton_Click"/>

                                </Grid>

                            </StackPanel>

                            <TextBlock
                                Grid.Column="3"
                                Text="Cross-server character / item / creature transfers"
                                Foreground="#7F8796"
                                VerticalAlignment="Center"
                                FontSize="11"/>

                        </Grid>

                    </Border>


                    <!-- STEAMCMD -->

                    <Border
                        Grid.Row="7"
                        Background="#14171C"
                        BorderBrush="#30343D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="SteamCMD"
                                Foreground="White"
                                FontWeight="Bold"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"/>

                            <TextBlock
                                x:Name="SteamCmdStatusText"
                                Grid.Column="1"
                                Text="● Checking..."
                                Foreground="Gold"
                                FontWeight="Bold"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"/>

                            <TextBlock
                                x:Name="SteamCmdLocationText"
                                Grid.Column="2"
                                Text="Checking..."
                                Foreground="#7F8796"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"/>

                            <Button
                                x:Name="InstallSteamCmdButton"
                                Grid.Column="3"
                                Content="Set Up SteamCMD"
                                Style="{StaticResource SecondaryButton}"
                                Click="InstallSteamCmdButton_Click"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- MODS -->
            <!-- ================================================= -->

            <Border
                Grid.Row="2"
                Background="#191C22"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Mods"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Bold"/>

                    <TextBlock
                        Grid.Row="1"
                        Text="Enter one CurseForge/ASA mod ID per line. Comma-separated IDs are also supported."
                        Foreground="#7F8796"
                        Margin="0,5,0,12"/>

                    <TextBox
                        x:Name="ModsTextBox"
                        Grid.Row="2"
                        MinHeight="100"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        Style="{StaticResource DarkTextBox}"
                        TextChanged="ModsTextBox_TextChanged"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- LAUNCH OPTIONS -->
            <!-- ================================================= -->

            <Border
                Grid.Row="3"
                Background="#191C22"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Launch Options"
                                Foreground="White"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="Live preview of exactly what will be launched."
                                Foreground="#7F8796"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="● LIVE"
                            Foreground="#59D66F"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>

                    <TextBox
                        x:Name="LaunchOptionsTextBox"
                        Grid.Row="1"
                        Margin="0,15,0,0"
                        MinHeight="90"
                        IsReadOnly="False"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        Style="{StaticResource DarkTextBox}"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- SERVER CONTROLS / MANAGEMENT -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="4"
                Margin="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- SERVER CONTROLS -->

                <Border
                    Grid.Column="0"
                    Background="#191C22"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="Server Controls"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="Bold"
                            Margin="0,0,0,20"/>

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">

                            <Button
                                x:Name="StartServerButton"
                                Content="Start Server"
                                Style="{StaticResource PrimaryButton}"
                                Width="130"
                                Click="StartServerButton_Click"/>

                            <Button
                                x:Name="StopServerButton"
                                Content="Stop Server"
                                Style="{StaticResource SecondaryButton}"
                                Width="130"
                                Click="StopServerButton_Click"
                                IsEnabled="False"/>

                            <Button
                                x:Name="StartClusterButton"
                                Content="Start Cluster"
                                Style="{StaticResource PrimaryButton}"
                                Width="130"
                                Click="StartClusterButton_Click"/>

                            <Button
                                x:Name="StopClusterButton"
                                Content="Stop Cluster"
                                Style="{StaticResource SecondaryButton}"
                                Width="130"
                                Click="StopClusterButton_Click"
                                IsEnabled="False"/>

                            <Button
                                x:Name="RestartServerButton"
                                Content="Restart"
                                Style="{StaticResource SecondaryButton}"
                                Width="130"
                                Click="RestartServerButton_Click"/>

                            <Button
                                x:Name="SaveWorldButton"
                                Content="Save World"
                                Style="{StaticResource PrimaryButton}"
                                Width="130"
                                Click="SaveWorldButton_Click"/>

                        </StackPanel>

                        <Grid Grid.Row="2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Runtime Status"
                                    Foreground="#7F8796"/>

                                <TextBlock
                                    x:Name="ServerRuntimeStatusText"
                                    Text="● OFFLINE"
                                    Foreground="IndianRed"
                                    FontWeight="Bold"
                                    Margin="0,4,0,0"/>

                                <TextBlock
                                    x:Name="ServerProcessIdText"
                                    Foreground="#7F8796"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Content="Edit Game.ini"
                                Style="{StaticResource SecondaryButton}"
                                Click="EditGameIniButton_Click"/>

                            <Button
                                Grid.Column="2"
                                Content="Edit GameUserSettings.ini"
                                Style="{StaticResource SecondaryButton}"
                                Click="EditGameUserSettingsButton_Click"/>

                        </Grid>

                    </Grid>

                </Border>


                <!-- SERVER MANAGEMENT -->

                <Border
                    Grid.Column="1"
                    Background="#191C22"
                    CornerRadius="8"
                    Padding="20"
                    Margin="10,0,0,0">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="Server Management"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="Bold"
                            Margin="0,0,0,15"/>

                        <Button
                            Grid.Row="1"
                            x:Name="InstallServerButton"
                            Content="Install Server"
                            Style="{StaticResource PrimaryButton}"
                            Click="InstallServerButton_Click"
                            HorizontalAlignment="Stretch"/>

                        <Button
                            Grid.Row="2"
                            x:Name="UpdateServerButton"
                            Content="Update Server"
                            Style="{StaticResource PrimaryButton}"
                            Click="UpdateServerButton_Click"
                            HorizontalAlignment="Stretch"/>

                        <Button
                            Grid.Row="3"
                            x:Name="VerifyServerButton"
                            Content="Verify Files"
                            Style="{StaticResource SecondaryButton}"
                            Click="VerifyServerButton_Click"
                            HorizontalAlignment="Stretch"/>

                        <StackPanel
                            Grid.Row="4"
                            Margin="5,10,5,0">

                            <Button
                                Content="Save Configuration"
                                Style="{StaticResource SecondaryButton}"
                                Click="SaveConfigButton_Click"
                                HorizontalAlignment="Stretch"/>

                            <Button
                                Content="Load Configuration"
                                Style="{StaticResource SecondaryButton}"
                                Click="LoadConfigButton_Click"
                                HorizontalAlignment="Stretch"/>

                        </StackPanel>


                        <!-- BACKUPS -->

                        <Border
                            Grid.Row="5"
                            Background="#14171C"
                            BorderBrush="#30343D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15"
                            Margin="0,15,0,0">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock
                                            Text="Backups"
                                            Foreground="White"
                                            FontSize="16"
                                            FontWeight="Bold"/>

                                        <TextBlock
                                            Text="Automatic and manual server backups"
                                            Foreground="#7F8796"
                                            FontSize="11"
                                            Margin="0,3,0,0"/>

                                    </StackPanel>

                                    <CheckBox
                                        x:Name="BackupEnabledCheckBox"
                                        Grid.Column="1"
                                        Content="Enable Automatic Backups"
                                        VerticalAlignment="Center"
                                        Checked="BackupSettingsChanged"
                                        Unchecked="BackupSettingsChanged"/>

                                </Grid>


                                <!-- BACKUP FOLDER -->

                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,12,0,0">

                                    <TextBlock
                                        Text="Backup Folder"
                                        Foreground="#7F8796"
                                        FontSize="11"
                                        Margin="0,0,0,5"/>

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="BackupFolderTextBox"
                                            Grid.Column="0"
                                            Style="{StaticResource DarkTextBox}"
                                            ToolTip="Folder where server backups will be stored"/>

                                        <Button
                                            Grid.Column="1"
                                            Content="Browse"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BrowseBackupFolderButton_Click"/>

                                    </Grid>

                                </StackPanel>


                                <!-- INTERVAL / RETENTION -->

                                <Grid
                                    Grid.Row="2"
                                    Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock
                                            Text="Backup Interval"
                                            Foreground="#7F8796"
                                            FontSize="11"
                                            Margin="0,0,0,5"/>

                                        <ComboBox
                                            x:Name="BackupIntervalComboBox"
                                            Style="{StaticResource DarkComboBox}"
                                            ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                            SelectedIndex="2"
                                            SelectionChanged="BackupIntervalComboBox_SelectionChanged">

                                            <ComboBoxItem
                                                Content="Every 5 minutes"
                                                Tag="5"/>

                                            <ComboBoxItem
                                                Content="Every 15 minutes"
                                                Tag="15"/>

                                            <ComboBoxItem
                                                Content="Every 30 minutes"
                                                Tag="30"/>

                                            <ComboBoxItem
                                                Content="Every 1 hour"
                                                Tag="60"/>

                                            <ComboBoxItem
                                                Content="Every 2 hours"
                                                Tag="120"/>

                                            <ComboBoxItem
                                                Content="Every 6 hours"
                                                Tag="360"/>

                                            <ComboBoxItem
                                                Content="Every 12 hours"
                                                Tag="720"/>

                                            <ComboBoxItem
                                                Content="Every 24 hours"
                                                Tag="1440"/>

                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock
                                            Text="Backups To Keep"
                                            Foreground="#7F8796"
                                            FontSize="11"
                                            Margin="0,0,0,5"/>

                                        <TextBox
                                            x:Name="BackupRetentionTextBox"
                                            Style="{StaticResource DarkTextBox}"
                                            Text="10"
                                            TextChanged="BackupRetentionTextBox_TextChanged"/>

                                    </StackPanel>

                                </Grid>


                                <!-- MANUAL BACKUPS -->

                                <StackPanel
                                    Grid.Row="3"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">

                                    <Button
                                        x:Name="RefreshBackupsButton"
                                        Content="Refresh"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="RefreshBackupsButton_Click"/>

                                    <Button
                                        x:Name="CreateBackupButton"
                                        Content="Create Backup"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="CreateBackupButton_Click"/>

                                </StackPanel>


                                <!-- BACKUP LIST -->

                                <Grid
                                    Grid.Row="4"
                                    Margin="0,10,0,0">

                                    <ListBox
                                        x:Name="BackupsListBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        MaxHeight="260"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>

                                            <Style TargetType="ListBoxItem">

                                                <Setter
                                                    Property="Background"
                                                    Value="Transparent"/>

                                                <Setter
                                                    Property="Padding"
                                                    Value="0"/>

                                                <Setter
                                                    Property="Margin"
                                                    Value="0"/>

                                                <Setter
                                                    Property="HorizontalContentAlignment"
                                                    Value="Stretch"/>

                                                <Setter Property="Template">

                                                    <Setter.Value>

                                                        <ControlTemplate
                                                            TargetType="ListBoxItem">

                                                            <ContentPresenter/>

                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>

                                            </Style>

                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>

                                            <DataTemplate>

                                                <Border
                                                    Background="#191C22"
                                                    BorderBrush="#30343D"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10"
                                                    Margin="0,0,0,6">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>

                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel
                                                            Grid.Column="0">

                                                            <TextBlock
                                                                Text="{Binding Name}"
                                                                Foreground="White"
                                                                FontWeight="SemiBold"
                                                                FontSize="12"/>

                                                            <TextBlock
                                                                Foreground="#7F8796"
                                                                FontSize="10"
                                                                Margin="0,3,0,0">

                                                                <Run Text="{Binding Type}"/>

                                                                <Run Text=" • "/>

                                                                <Run Text="{Binding Created}"/>

                                                            </TextBlock>

                                                        </StackPanel>

                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Orientation="Horizontal">

                                                            <Button
                                                                Content="Restore"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="RestoreBackupButton_Click"
                                                                Tag="{Binding}"
                                                                Padding="10,6"/>

                                                            <Button
                                                                Content="Delete"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="DeleteBackupButton_Click"
                                                                Tag="{Binding}"
                                                                Padding="10,6"/>

                                                        </StackPanel>

                                                    </Grid>

                                                </Border>

                                            </DataTemplate>

                                        </ListBox.ItemTemplate>

                                    </ListBox>

                                    <TextBlock
                                        x:Name="NoBackupsText"
                                        Text="No backups yet. Click Create Backup to make one."
                                        Foreground="#7F8796"
                                        FontSize="11"
                                        Visibility="Collapsed"/>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <Border
                Grid.Row="5"
                Background="#191C22"
                CornerRadius="8"
                Padding="20"
                Margin="0,20,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="MAP"
                            Foreground="#7F8796"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="SummaryMapText"
                            Text="Not configured"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock
                            Text="PLAYERS"
                            Foreground="#7F8796"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="SummaryPlayersText"
                            Text="0 / 0"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock
                            Text="MODS"
                            Foreground="#7F8796"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="SummaryModsText"
                            Text="0"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="3">

                        <TextBlock
                            Text="CLUSTER"
                            Foreground="#7F8796"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="SummaryClusterText"
                            Text="Disabled"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="4">

                        <TextBlock
                            Text="WHITELIST"
                            Foreground="#7F8796"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="SummaryWhitelistText"
                            Text="Disabled"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CONSOLE -->
            <!-- ================================================= -->

            <Border
                Grid.Row="6"
                Background="#191C22"
                CornerRadius="8"
                Padding="20"
                Margin="0,20,0,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="300"/>

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Console"
                                Foreground="White"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="SteamCMD and ASA server output"
                                Foreground="#7F8796"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                        <Button
                            x:Name="ClearConsoleButton"
                            Grid.Column="1"
                            Content="Clear Console"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearConsoleButton_Click"/>

                    </Grid>

                    <TextBox
                        x:Name="ConsoleTextBox"
                        Grid.Row="1"
                        Margin="0,15,0,0"
                        Background="#0D0F12"
                        Foreground="#D7DCE5"
                        BorderBrush="#30343D"
                        BorderThickness="1"
                        Padding="12"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- HIDDEN MONITOR HOST -->
            <!-- ================================================= -->
            <!--
                IMPORTANT:
                ServerPage.xaml.cs still references MonitorHost.

                We keep the control so the C# code compiles,
                but it is collapsed so the Server Monitor no longer
                appears on the main Server page.

                The dedicated Monitor tab/page is responsible for
                displaying the actual monitor.
            -->

            <ContentControl
                x:Name="MonitorHost"
                Grid.Row="0"
                Visibility="Collapsed"/>

        </Grid>

    </ScrollViewer>

</UserControl>